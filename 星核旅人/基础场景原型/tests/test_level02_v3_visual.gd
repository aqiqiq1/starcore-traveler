extends Node

## Controlled engine render of the approved V3 platform slices only.
##
## Run with the GUI executable (this test needs a real renderer):
##   Godot_v4.7.2-stable_win64.exe --path . res://tests/test_level02_v3_visual.tscn
##
## It instantiates the production level_02 scene inside a 640x360 SubViewport
## with a transparent background, hides every non-platform visual at runtime
## (this test only; the production scene is not changed), then compares the
## rendered RGBA image with `level02_v3_platform_expected.png`.
##
## The expected file is an exact alpha composite of the two approved layers:
##   layer_platform_visual_640.png
##   layer_platform_decor_640.png
## It is generated by a separate Python verification step, not by this test.
##
## This is a visual-only validation. It does not replace the real-input
## gameplay suite or the GUI route captures.

const LEVEL_SCENE: PackedScene = preload("res://scenes/level_02.tscn")
const EXPECTED_PATH: String = "res://assets/level02_platform_v3/level02_v3_platform_expected.png"
const RENDER_PATH: String = "res://screenshots/level02_v3_platform_only_render.png"
const RAW_RENDER_PATH: String = "res://screenshots/level02_v3_platform_only_render_raw.png"
const LOG_PATH: String = "res://tests/logs/level02_v3_visual_render.log"
const JSON_PATH: String = "res://tests/logs/level02_v3_visual_render.json"

const HIDE_PATHS: Array[String] = [
	"Background",
	"TerrainTop",
	"TerrainFill",
	"Bays",
	"Core",
	"Player",
	"Exit",
	"StartStele",
	"HUD",
	"StartBayLabel",
	"TargetBayLabel",
	"CorridorLabel",
	"UpperLabel",
	"ExitStatus",
]

var _lines: Array[String] = []
var _pass_count: int = 0
var _fail_count: int = 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	await get_tree().process_frame

	var viewport: SubViewport = SubViewport.new()
	viewport.size = Vector2i(640, 360)
	viewport.transparent_bg = true
	viewport.disable_3d = true
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	viewport.canvas_item_default_texture_filter = (
		Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
	)
	add_child(viewport)

	var level: Level02 = LEVEL_SCENE.instantiate() as Level02
	viewport.add_child(level)
	for _i: int in range(8):
		await get_tree().physics_frame

	for path: String in HIDE_PATHS:
		var node: Node = level.get_node_or_null(path)
		if node is CanvasItem:
			(node as CanvasItem).visible = false
		elif node is CanvasLayer:
			(node as CanvasLayer).visible = false

	for _i: int in range(3):
		await get_tree().process_frame
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw

	var render: Image = viewport.get_texture().get_image()
	var expected: Image = (load(EXPECTED_PATH) as Texture2D).get_image()
	_log("Level 02 V3 controlled platform-only render")
	_log("Godot %s  display=%s" % [
		Engine.get_version_info()["string"], DisplayServer.get_name(),
	])
	_check(render != null, "SubViewport produced a render image")
	_check(render.get_size() == Vector2i(640, 360),
		"render is 640x360", str(render.get_size()) if render != null else "null")
	_check(expected.get_size() == Vector2i(640, 360),
		"expected reference is 640x360", str(expected.get_size()))
	render.convert(Image.FORMAT_RGBA8)
	expected.convert(Image.FORMAT_RGBA8)

	# A transparent SubViewport readback stores premultiplied RGB. Detect it on
	# the approved semi-transparent moss pixel at (248,297); opaque areas are
	# unaffected either way. We keep the raw readback as evidence and also save
	# an unpremultiplied copy for viewing.
	var probe: Color = render.get_pixel(248, 297)
	var premultiplied_readback: bool = (
		absi(int(round(probe.r * 255.0)) - 86) <= 1
		and absi(int(round(probe.g * 255.0)) - 104) <= 1
		and absi(int(round(probe.b * 255.0)) - 88) <= 1
	)

	var straight: Image = render.duplicate()
	for y: int in range(360):
		for x: int in range(640):
			var c: Color = straight.get_pixel(x, y)
			if c.a > 0.0 and c.a < 1.0:
				c.r = minf(c.r / c.a, 1.0)
				c.g = minf(c.g / c.a, 1.0)
				c.b = minf(c.b / c.a, 1.0)
				straight.set_pixel(x, y, c)

	var raw_error: Error = render.save_png(ProjectSettings.globalize_path(RAW_RENDER_PATH))
	var save_error: Error = straight.save_png(ProjectSettings.globalize_path(RENDER_PATH))
	_check(raw_error == OK and save_error == OK, "platform-only render saved",
		"%s raw=%s straight=%s" % [
			error_string(save_error), error_string(raw_error), RENDER_PATH,
		])

	var mismatch_pixels: int = 0
	var max_channel_diff: int = 0
	var first_mismatch: String = ""
	var nonzero_render: int = 0
	var nonzero_expected: int = 0
	var semi_transparent_pixels: int = 0
	for y: int in range(360):
		for x: int in range(640):
			var got: Color = render.get_pixel(x, y)
			var want: Color = expected.get_pixel(x, y)
			if got.a > 0.0:
				nonzero_render += 1
			if want.a > 0.0:
				nonzero_expected += 1
			if got.a > 0.0 and got.a < 1.0:
				semi_transparent_pixels += 1
			var diff: int = _pixel_diff(got, want, premultiplied_readback)
			max_channel_diff = maxi(max_channel_diff, diff)
			if diff > 0:
				mismatch_pixels += 1
				if first_mismatch.is_empty():
					first_mismatch = "(%d,%d) got=%s want=%s" % [x, y, str(got), str(want)]

	_log("readback encoding: premultiplied=%s  semi-transparent pixels=%d" % [
		str(premultiplied_readback), semi_transparent_pixels,
	])
	_check(nonzero_render > 0, "render contains visible platform pixels",
		str(nonzero_render))
	_check(nonzero_expected > 0, "reference contains visible platform pixels",
		str(nonzero_expected))
	_check(premultiplied_readback,
		"transparent readback is identifiably premultiplied (decoded accordingly)")
	_check(mismatch_pixels == 0,
		"rendered platform-only RGBA matches the approved-layer composite exactly",
		"mismatch=%d max_channel_diff=%d semi=%d first=%s" % [
			mismatch_pixels, max_channel_diff, semi_transparent_pixels, first_mismatch,
		])

	_write_report({
		"godot": Engine.get_version_info()["string"],
		"display": DisplayServer.get_name(),
		"viewport": [640, 360],
		"transparent_bg": true,
		"render": RENDER_PATH,
		"raw_render": RAW_RENDER_PATH,
		"expected": EXPECTED_PATH,
		"premultiplied_readback": premultiplied_readback,
		"semi_transparent_pixels": semi_transparent_pixels,
		"pass": _pass_count,
		"fail": _fail_count,
		"mismatch_pixels": mismatch_pixels,
		"max_channel_diff": max_channel_diff,
		"first_mismatch": first_mismatch,
		"nonzero_render": nonzero_render,
		"nonzero_expected": nonzero_expected,
		"note": "Platform/decor slices only; all other visuals hidden at runtime in this test scene. Production scene is unchanged. The transparent SubViewport readback is premultiplied; the exact comparison applies the same premultiplication to the approved-layer reference, and the saved straight-alpha PNG is unpremultiplied for viewing.",
	})
	_log("TEST_SUMMARY pass=%d fail=%d" % [_pass_count, _fail_count])
	_log("RESULT: %s" % ("PASS" if _fail_count == 0 else "FAIL"))
	get_tree().quit(0 if _fail_count == 0 else 1)


func _pixel_diff(a: Color, b: Color, premultiplied: bool) -> int:
	var aa: int = int(round(a.a * 255.0))
	var ba: int = int(round(b.a * 255.0))
	if aa != ba:
		return 255
	if aa == 0:
		return 0
	var ar: int = int(round(a.r * 255.0))
	var ag: int = int(round(a.g * 255.0))
	var ab: int = int(round(a.b * 255.0))
	var br: int = int(round(b.r * 255.0))
	var bg: int = int(round(b.g * 255.0))
	var bb: int = int(round(b.b * 255.0))
	if premultiplied and aa < 255:
		var k: float = float(aa) / 255.0
		br = int(round(br * k))
		bg = int(round(bg * k))
		bb = int(round(bb * k))
	return maxi(maxi(absi(ar - br), absi(ag - bg)), absi(ab - bb))


func _check(condition: bool, label: String, detail: String = "") -> void:
	if condition:
		_pass_count += 1
		_log("[PASS] %s  (%s)" % [label, detail])
	else:
		_fail_count += 1
		_log("[FAIL] %s  (%s)" % [label, detail])


func _log(line: String) -> void:
	_lines.append(line)
	print(line)


func _write_report(report: Dictionary) -> void:
	var text: String = "\n".join(_lines) + "\n"
	var file: FileAccess = FileAccess.open(LOG_PATH, FileAccess.WRITE)
	if file != null:
		file.store_string(text)
		file.close()
	var json: FileAccess = FileAccess.open(JSON_PATH, FileAccess.WRITE)
	if json != null:
		json.store_string(JSON.stringify(report, "  ") + "\n")
		json.close()
