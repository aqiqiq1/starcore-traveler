class_name LoomAudio
extends Node

## Chapter-local audio for 星核织机.
##
## The ten WAVs in res://dlc/star_loom/assets/audio are generated by
## tools/gen_assets.py (peak-normalised to -3 dBFS).  DemoAudio is still used by
## the chapter for the shared player swing / hurt / failure / respawn cues, the
## same approved sounds the base levels use.
##
## Music is a reserved path: res://dlc/audio/music/loom_boss.ogg.  Another
## agent may add that file later, so this loader only checks at runtime.  When
## the file is absent the chapter is simply silent; no warning, no error.

const MUSIC_PATH: String = "res://dlc/audio/music/loom_boss.ogg"
## Light city-hall reverb.  Every local music/SFX player is routed to this bus;
## the shared DemoAudio cues stay on their approved Master routing.
const REVERB_BUS_NAME: String = "LoomReverb"
const REVERB_ROOM: float = 0.60
const REVERB_WET: float = 0.20
const REVERB_DRY: float = 0.85
const REVERB_DAMPING: float = 0.45
const REVERB_SPREAD: float = 0.35
const REVERB_PREDELAY_MSEC: float = 35.0
## The generated track peaks at -8.05 dBFS.  A -6 dB player gain leaves the
## final peak at about -14.05 dBFS: audible under the fight cues, without
## pushing the Master bus.  The .import sidecar is left at loop=false; looping
## is set on the loaded stream here, in code, on purpose.
const MUSIC_DB: float = -6.0

const NODE_HIT: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_node_hit.wav"
)
const NODE_BREAK: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_node_break.wav"
)
const CORE_HIT: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_core_hit.wav"
)
const CORE_EXPOSED: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_core_exposed.wav"
)
const DENY: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_deny.wav"
)
const TELEGRAPH: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_telegraph.wav"
)
const SWEEP: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_sweep.wav"
)
const SUMMON: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_summon.wav"
)
const FIRE: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_fire.wav"
)
const GEAR: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_gear.wav"
)
const STAGE: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_stage.wav"
)
const COMPLETE: AudioStreamWAV = preload(
	"res://dlc/star_loom/assets/audio/sfx_complete.wav"
)

var _node_hit: AudioStreamPlayer
var _bullet: AudioStreamPlayer
var _node_break: AudioStreamPlayer
var _core_hit: AudioStreamPlayer
var _core_exposed: AudioStreamPlayer
var _deny: AudioStreamPlayer
var _telegraph: AudioStreamPlayer
var _sweep: AudioStreamPlayer
var _summon: AudioStreamPlayer
var _fire: AudioStreamPlayer
var _gear: AudioStreamPlayer
var _stage: AudioStreamPlayer
var _complete: AudioStreamPlayer
var _music: AudioStreamPlayer = null
var _telegraph_plays: int = 0
var _hit_plays: int = 0


func _ready() -> void:
	_ensure_reverb_bus()
	_node_hit = _make_player("NodeHit", NODE_HIT, 0.0)
	_bullet = _make_player("Bullet", NODE_HIT, -8.0)
	_bullet.pitch_scale = 0.74
	_node_break = _make_player("NodeBreak", NODE_BREAK, 0.0)
	_core_hit = _make_player("CoreHit", CORE_HIT, 0.0)
	_core_exposed = _make_player("CoreExposed", CORE_EXPOSED, 0.0)
	_deny = _make_player("Deny", DENY, -3.0)
	_telegraph = _make_player("Telegraph", TELEGRAPH, -2.0)
	_sweep = _make_player("Sweep", SWEEP, 0.0)
	_summon = _make_player("Summon", SUMMON, 0.0)
	_fire = _make_player("Fire", FIRE, 0.0)
	_gear = _make_player("Gear", GEAR, 0.0)
	_stage = _make_player("Stage", STAGE, 0.0)
	_complete = _make_player("Complete", COMPLETE, 0.0)
	_setup_music()


## Idempotent: a chapter restart or a second scene in one process reuses the
## same bus and only repairs a missing/wrong reverb effect.
func _ensure_reverb_bus() -> void:
	var index: int = AudioServer.get_bus_index(REVERB_BUS_NAME)
	if index < 0:
		AudioServer.add_bus()
		index = AudioServer.bus_count - 1
		AudioServer.set_bus_name(index, REVERB_BUS_NAME)
		AudioServer.set_bus_send(index, "Master")
	var effect: AudioEffectReverb = _find_reverb(index)
	if effect == null:
		effect = AudioEffectReverb.new()
		AudioServer.add_bus_effect(index, effect)
	effect.room_size = REVERB_ROOM
	effect.wet = REVERB_WET
	effect.dry = REVERB_DRY
	effect.damping = REVERB_DAMPING
	effect.spread = REVERB_SPREAD
	effect.predelay_msec = REVERB_PREDELAY_MSEC


func _find_reverb(index: int) -> AudioEffectReverb:
	for effect_index: int in range(AudioServer.get_bus_effect_count(index)):
		var effect: AudioEffect = AudioServer.get_bus_effect(index, effect_index)
		if effect is AudioEffectReverb:
			return effect as AudioEffectReverb
	return null


func _make_player(
	player_name: String, stream: AudioStream, volume_db: float
) -> AudioStreamPlayer:
	var player: AudioStreamPlayer = AudioStreamPlayer.new()
	player.name = player_name
	player.stream = stream
	player.volume_db = volume_db
	player.bus = REVERB_BUS_NAME
	add_child(player)
	return player


## Missing music is a silent, supported state: this is not an error path.
func _setup_music() -> void:
	if not ResourceLoader.exists(MUSIC_PATH):
		return
	var stream: Resource = ResourceLoader.load(MUSIC_PATH)
	if not (stream is AudioStream):
		return
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	elif stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = true
	_music = AudioStreamPlayer.new()
	_music.name = "Music"
	_music.stream = stream as AudioStream
	_music.volume_db = MUSIC_DB
	_music.bus = REVERB_BUS_NAME
	# The guide and teaching popup pause the tree.  Music must keep running
	# through those pages, so the player itself is ALWAYS; the pause page then
	# pauses it explicitly through stream_paused.
	_music.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_music)


func start_music() -> void:
	if _music == null:
		return
	_music.stream_paused = false
	if not _music.playing:
		_music.play()


func stop_music() -> void:
	if _music != null:
		_music.stream_paused = false
		_music.stop()


## The pause page is the one place music really stops; the guide and the
## teaching popup keep it playing because their tree pause does not touch this
## PROCESS_MODE_ALWAYS player.
func pause_music() -> void:
	if _music != null and _music.playing:
		_music.stream_paused = true


func resume_music() -> void:
	if _music != null:
		_music.stream_paused = false


func is_music_paused() -> bool:
	return _music != null and _music.stream_paused


func is_music_available() -> bool:
	return _music != null


func is_music_playing() -> bool:
	return _music != null and _music.playing


func get_music_player() -> AudioStreamPlayer:
	return _music


func get_music_loop() -> bool:
	if _music == null or _music.stream == null:
		return false
	if _music.stream is AudioStreamOggVorbis:
		return (_music.stream as AudioStreamOggVorbis).loop
	if _music.stream is AudioStreamMP3:
		return (_music.stream as AudioStreamMP3).loop
	return false


func get_music_volume_db() -> float:
	return _music.volume_db if _music != null else 0.0


func get_music_length() -> float:
	if _music == null or _music.stream == null:
		return 0.0
	return _music.stream.get_length()


func get_music_position() -> float:
	return _music.get_playback_position() if _music != null else 0.0


func seek_music(seconds: float) -> void:
	if _music == null or not _music.playing:
		return
	_music.seek(clampf(seconds, 0.0, maxf(get_music_length() - 0.01, 0.0)))


func play_node_hit() -> void:
	_hit_plays += 1
	if _node_hit != null:
		_node_hit.pitch_scale = randf_range(0.96, 1.04)
		_node_hit.play()


func play_node_break() -> void:
	if _node_break != null:
		_node_break.play()


func play_core_hit() -> void:
	if _core_hit != null:
		_core_hit.play()


func play_core_exposed() -> void:
	if _core_exposed != null:
		_core_exposed.play()


func play_deny() -> void:
	if _deny != null:
		_deny.play()


func play_telegraph() -> void:
	_telegraph_plays += 1
	if _telegraph != null:
		_telegraph.play()


func play_bullet() -> void:
	if _bullet != null:
		_bullet.play()


func play_sweep() -> void:
	if _sweep != null:
		_sweep.play()


func play_summon() -> void:
	if _summon != null:
		_summon.play()


func play_fire() -> void:
	if _fire != null:
		_fire.play()


func play_gear() -> void:
	if _gear != null:
		_gear.play()


func play_stage() -> void:
	if _stage != null:
		_stage.play()


func play_complete() -> void:
	if _complete != null:
		_complete.play()


func stop_all() -> void:
	stop_music()
	for player: AudioStreamPlayer in [
		_node_hit, _bullet, _node_break, _core_hit, _core_exposed, _deny,
		_telegraph, _sweep, _summon, _fire, _gear, _stage, _complete,
	]:
		if player != null:
			player.stop()


## Scene shutdown: release the OGG playback/stream references before the
## SceneTree exits.  `stop_all()` is also used for R and the title flow, where
## the streams must stay loaded, so this is a separate exit-only path.
func shutdown() -> void:
	if _music != null:
		_music.stop()
		_music.stream = null
	for player: AudioStreamPlayer in [
		_node_hit, _bullet, _node_break, _core_hit, _core_exposed, _deny,
		_telegraph, _sweep, _summon, _fire, _gear, _stage, _complete,
	]:
		if player != null:
			player.stop()
			player.stream = null


# --- read API for tests ----------------------------------------------------

func get_reverb_bus_name() -> String:
	return REVERB_BUS_NAME


func get_reverb_bus_index() -> int:
	return AudioServer.get_bus_index(REVERB_BUS_NAME)


func has_reverb_bus() -> bool:
	return get_reverb_bus_index() >= 0


func get_reverb_effect() -> AudioEffectReverb:
	var index: int = get_reverb_bus_index()
	if index < 0:
		return null
	return _find_reverb(index)


func get_player_bus(player_name: String) -> String:
	for player: AudioStreamPlayer in [
		_node_hit, _bullet, _node_break, _core_hit, _core_exposed, _deny,
		_telegraph, _sweep, _summon, _fire, _gear, _stage, _complete, _music,
	]:
		if player != null and player.name == player_name:
			return player.bus
	return ""


func get_telegraph_play_count() -> int:
	return _telegraph_plays


func get_hit_play_count() -> int:
	return _hit_plays
