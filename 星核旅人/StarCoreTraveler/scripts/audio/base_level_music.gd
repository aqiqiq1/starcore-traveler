class_name BaseLevelMusic
extends Node

## Whole-loop BGM player for base campaign levels 01-03.
##
## The three tracks are generated by res://tools/generate_base_music.py
## (archived there, never exported) and written to res://assets/audio/music/
## as 48 kHz stereo OGG Vorbis.  This node resolves the file at runtime,
## duplicates the loaded stream, forces whole-file looping on that duplicate
## only, and stays silent without an error when the file is missing.  Nothing
## is preloaded, so an absent or not-yet-imported track cannot break a level,
## the editor import, or a test.
##
## Level wiring (see level_01/02/03.gd):
##   - gameplay entry starts the track;
##   - the pause page sets stream_paused and resuming continues in place;
##   - completion fades it out;
##   - R restarts it from the first frame;
##   - leaving for the title or the next level stops it immediately.
##
## Volume: -10 dB, the same level as the DLC chapter ambience.  The generated
## tracks peak near -8 dBFS.  The node and player are PROCESS_MODE_ALWAYS so a
## paused tree cannot cut the stream; the pause page still freezes playback
## explicitly through set_paused().

const MUSIC_DIRECTORY: String = "res://assets/audio/music/"
const EXTENSIONS: Array[String] = [".ogg", ".wav"]
const TARGET_VOLUME_DB: float = -10.0
const SILENT_DB: float = -60.0
const STOP_FADE_SECONDS: float = 0.7
## A decoded stream shorter than this is treated as missing / not usable.
const MIN_STREAM_SECONDS: float = 0.25

@export var track_name: String = ""
@export var autoplay: bool = true

var _player: AudioStreamPlayer = null
var _stream: AudioStream = null
var _resolved_path: String = ""
var _paused: bool = false
var _stop_tween: Tween = null


func _ready() -> void:
	# The pause page pauses the tree; music is frozen explicitly by set_paused
	# instead of being stopped by the pause mode.
	process_mode = Node.PROCESS_MODE_ALWAYS
	_resolve_stream()
	if autoplay:
		play()


func _exit_tree() -> void:
	_kill_stop_tween()
	_paused = false
	if _player != null:
		_player.stop()
		# Drop the stream reference so a level torn down while the track is
		# playing cannot leave the Ogg packet sequence alive at exit.
		_player.stream = null
	_stream = null


# --- resolution -------------------------------------------------------------

## Loads the first usable .ogg/.wav for `track_name`.  Kept separate from
## _ready so tests can exercise the missing-file fallback without touching a
## real track.
func _resolve_stream() -> void:
	_resolved_path = ""
	_stream = null
	if track_name.is_empty():
		return
	for extension: String in EXTENSIONS:
		var candidate: String = MUSIC_DIRECTORY + track_name + extension
		if not ResourceLoader.exists(candidate):
			continue
		var loaded: Resource = ResourceLoader.load(
			candidate, "", ResourceLoader.CACHE_MODE_IGNORE
		)
		if not (loaded is AudioStream):
			continue
		var stream: AudioStream = (loaded as AudioStream).duplicate() as AudioStream
		if stream == null:
			continue
		if stream.get_length() < MIN_STREAM_SECONDS:
			# A still-being-written or empty encode is not level music.
			continue
		_apply_loop(stream)
		_stream = stream
		_resolved_path = candidate
		return


func _apply_loop(stream: AudioStream) -> void:
	if stream is AudioStreamOggVorbis:
		var ogg: AudioStreamOggVorbis = stream as AudioStreamOggVorbis
		ogg.loop = true
		ogg.loop_offset = 0.0
	elif stream is AudioStreamWAV:
		var wav: AudioStreamWAV = stream as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = maxi(int(round(wav.get_length() * float(wav.mix_rate))), 1)
	elif stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = true


func _ensure_player() -> void:
	if _stream == null:
		return
	if _player == null:
		_player = AudioStreamPlayer.new()
		_player.name = "MusicPlayer"
		_player.stream = _stream
		_player.volume_db = TARGET_VOLUME_DB
		_player.bus = &"Master"
		_player.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(_player)


# --- playback ---------------------------------------------------------------

## Starts (or restarts) the track.  from_start = false only resumes if the
## player was paused; the default is a clean restart, used by a level's gameplay
## entry and by R.
func play(from_start: bool = true) -> void:
	_ensure_player()
	if _player == null:
		return
	_kill_stop_tween()
	_player.volume_db = TARGET_VOLUME_DB
	_paused = false
	_player.stream_paused = false
	if from_start or not _player.playing:
		_player.play()


func set_paused(value: bool) -> void:
	_paused = value
	if _player != null:
		_player.stream_paused = value


## Stops immediately (fade_time = 0) or fades out first.  The fade is used on
## the completion page; scene changes stop immediately.
func stop(fade_time: float = 0.0) -> void:
	_paused = false
	if _player == null:
		return
	_player.stream_paused = false
	_kill_stop_tween()
	if not _player.playing:
		_player.volume_db = TARGET_VOLUME_DB
		return
	if fade_time <= 0.0 or not is_inside_tree():
		_player.stop()
		_player.volume_db = TARGET_VOLUME_DB
		return
	_stop_tween = create_tween()
	_stop_tween.tween_property(_player, "volume_db", SILENT_DB, fade_time)
	_stop_tween.tween_callback(func() -> void:
		if _player != null:
			_player.stop()
			_player.volume_db = TARGET_VOLUME_DB
	)


func _kill_stop_tween() -> void:
	if _stop_tween != null and _stop_tween.is_valid():
		_stop_tween.kill()
	_stop_tween = null


# --- read API (level / tests) ----------------------------------------------

func has_stream() -> bool:
	return _player != null and _player.stream != null


func is_playing() -> bool:
	return _player != null and _player.playing and not _player.stream_paused


func is_music_paused() -> bool:
	return _paused


func get_track_name() -> String:
	return track_name


func get_stream_path() -> String:
	return _resolved_path


func get_stream_length() -> float:
	return _stream.get_length() if _stream != null else 0.0


func get_volume_db() -> float:
	return _player.volume_db if _player != null else TARGET_VOLUME_DB


func get_playback_position() -> float:
	return _player.get_playback_position() if _player != null else 0.0


func is_stream_looping() -> bool:
	if _stream is AudioStreamOggVorbis:
		return (_stream as AudioStreamOggVorbis).loop
	if _stream is AudioStreamWAV:
		return (
			(_stream as AudioStreamWAV).loop_mode
			!= AudioStreamWAV.LOOP_DISABLED
		)
	if _stream is AudioStreamMP3:
		return (_stream as AudioStreamMP3).loop
	return false


func get_player() -> AudioStreamPlayer:
	return _player
